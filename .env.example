PORT=3000
# Comma-separated allowlist. '*' works only outside production —
# production refuses to boot with '*' or empty (decision 115).
CORS_ORIGIN=http://localhost:8080

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vgr

# REQUIRED — production refuses to boot without it (plano-seguranca.md A2).
JWT_SECRET=change-me
JWT_EXPIRES_IN=24h

# API docs are off in production unless explicitly enabled (finding A3).
# SWAGGER_ENABLED=true

# Master key for envelope encryption (decisions 44/111) — 32 random bytes,
# base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# REQUIRED in production (boot refuses without it). Keep OUT of the repo;
# secret manager in deployment. Bump LEGAL_KEK_VERSION when rotating.
LEGAL_KEK=
LEGAL_KEK_VERSION=1

# Password recovery email (empty SMTP_HOST = dev mode, code goes to the log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_CHANGE_PASSWORD_URL=http://localhost:8080/#/change-password

# App-plane social login (decisions 119/152). This is the "Web application"
# type OAuth client id from Google Cloud Console — public, not a secret; it
# is the `aud` the API checks a Google ID token against. Empty = Google
# login answers 422 NOT_AVAILABLE (fail-closed, same pattern as the L2
# provider gate). Apple/Facebook are not wired yet.
GOOGLE_OAUTH_CLIENT_ID=

# --- Media storage (decisions 126-131, plano-imagens.md) ---
# Master key for media envelope encryption — SEPARATE from LEGAL_KEK on
# purpose. 32 random bytes, base64 (same generator as LEGAL_KEK).
# REQUIRED in production.
MEDIA_KEK=
MEDIA_KEK_VERSION=1

# 'fs' (dev/test: local disk) or 's3' (MinIO in the MVP — decision 126;
# any S3-compatible provider later, same adapter).
BLOB_STORE=fs
MEDIA_FS_ROOT=data/media

# Only when BLOB_STORE=s3 (all four required in production then).
# MinIO example: S3_ENDPOINT=http://127.0.0.1:9000
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=vgr-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Upload limits (decision 129) — config, not code.
MEDIA_MAX_BYTES=10485760
MEDIA_MAX_PER_REPORT=10
# Decision 136: pending media never attached to a report expires after
# this many hours and is crypto-shredded by the retention job.
MEDIA_ORPHAN_TTL_HOURS=48

# Decision 127: avatar class stays OFF in the MVP.
AVATAR_ENABLED=false

# --- Payment rail (decisions 96/100/143, plano-psp-requisitos.md) ---
# Asaas is a RESEARCH CANDIDATE, not the closed decision 59 — nothing calls
# this port yet (no Reward module exists). Sandbox URL by default; never
# point at production before checklist items B2-B4/D1 are confirmed with
# Asaas directly (see asaas-payment-rail.ts header).
ASAAS_API_URL=https://api-sandbox.asaas.com
ASAAS_API_KEY=
# Retention window before Conta Escrow auto-releases (only documented cap).
ASAAS_ESCROW_DAYS_TO_EXPIRE=30

# Decisions 148/149: contest window between a mediation resolution's
# approval and its execution at the rail. Must fit inside
# ASAAS_ESCROW_DAYS_TO_EXPIRE.
MEDIATION_CONTEST_WINDOW_DAYS=7
