# /etc/vgr/api-prod.env and /etc/vgr/api-homolog.env — root only (chmod 600).
# One file per environment, NOTHING shared between them (decision 242):
# different database user, bucket, Garage key and master keys.
# Boot refuses to start without JWT_SECRET, CORS_ORIGIN, LEGAL_KEK and
# MEDIA_KEK (docs/adr/RELEASE.md).

NODE_ENV=production
PORT=3000

# The panel of THIS environment: https://painel.<domain> or
# https://painel-homolog.<domain>. Never '*'.
CORS_ORIGIN=https://painel.example.com

# prod: vgr / vgr        homolog: vgr_homolog / vgr_homolog
DB_HOST=mariadb
DB_PORT=3306
DB_USER=vgr
DB_NAME=vgr
# The matching password from mariadb.env.
DB_PASSWORD=

# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
# Same generator. Losing a KEK loses everything it encrypted: keep its
# offline copy (decision 243) BEFORE the first boot.
LEGAL_KEK=
LEGAL_KEK_VERSION=1
MEDIA_KEK=
MEDIA_KEK_VERSION=1

# Legal Gate (decisions 76-79, 104): BR is this installation's real
# jurisdiction — every gated feature stays blocked until a rule for it is
# active (panel, Legal Gate screens). SANDBOX inverts that default and is
# for development and demos.
LEGAL_JURISDICTION=BR

# Garage (decision 249). prod: bucket vgr-media; homolog: vgr-media-homolog.
# Key id and secret printed by deploy/garage/init.sh for this environment.
BLOB_STORE=s3
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=vgr-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# A real sender is required for e-mail verification and password recovery
# (decision 247); without SMTP_HOST no e-mail leaves the server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_CHANGE_PASSWORD_URL=https://painel.example.com/#/change-password

# The Web-type Google client of THIS environment — the same id the app is
# built with (--dart-define=GOOGLE_SERVER_CLIENT_ID). Empty = Google login off.
GOOGLE_OAUTH_CLIENT_ID=

# Monetary rewards stay off in the closed phase (decision 247): no
# ASAAS_API_KEY.
