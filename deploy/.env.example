# Non-secret settings of the stack (copy to deploy/.env on the server).
# Host names: the domain is round 22 item 4 — still open.
ACME_EMAIL=ops@example.com
API_HOST=api.example.com
PANEL_HOST=painel.example.com
API_HOMOLOG_HOST=api-homolog.example.com
PANEL_HOMOLOG_HOST=painel-homolog.example.com

# Where the secret files live (decision 243) and where backups are staged.
VGR_SECRETS_DIR=/etc/vgr
BACKUP_DIR=/var/backups/vgr
PANEL_ROOT=/srv/vgr/panel
